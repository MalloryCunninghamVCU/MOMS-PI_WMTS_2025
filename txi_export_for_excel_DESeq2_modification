#################################################################################### DEseq2 Analysis code

###Subset txi abundance to match the final filtered sample set used in dds_filtered
final_samples <- colnames(dds_filtered)

gene_tpm <- txi$abundance[, final_samples, drop = FALSE]

stopifnot(
  is.numeric(gene_tpm),
  !is.null(rownames(gene_tpm)),
  !is.null(colnames(gene_tpm)),
  all(is.finite(gene_tpm)),
  all(gene_tpm >= 0),
  all(colnames(gene_tpm) == final_samples)
)

###Save as RDS
saveRDS(gene_tpm, file = "gene_tpm_for_xCell2.rds")

###convert Ensembl IDs to gene symbols for xCell2
ens_ids <- sub("\\..*", "", rownames(gene_tpm))

gene_symbols <- mapIds(
  org.Hs.eg.db,
  keys = ens_ids,
  column = "SYMBOL",
  keytype = "ENSEMBL",
  multiVals = "first"
)

gene_symbols[is.na(gene_symbols)] <- ens_ids[is.na(gene_symbols)]

gene_tpm_df <- as.data.frame(gene_tpm)
gene_tpm_df$gene_symbol <- gene_symbols

###Aggregate duplicated gene symbols by summing
gene_tpm_symbol <- gene_tpm_df %>%
  filter(!is.na(gene_symbol), gene_symbol != "") %>%
  group_by(gene_symbol) %>%
  summarise(across(where(is.numeric), sum), .groups = "drop") %>%
  as.data.frame()

rownames(gene_tpm_symbol) <- gene_tpm_symbol$gene_symbol
gene_tpm_symbol$gene_symbol <- NULL
gene_tpm_symbol <- as.matrix(gene_tpm_symbol)

saveRDS(gene_tpm_symbol, file = "gene_tpm_symbol_for_xCell2.rds")


###export
gene_tpm_symbol_export <- as.data.frame(gene_tpm_symbol)
gene_tpm_symbol_export$gene <- rownames(gene_tpm_symbol_export)
gene_tpm_symbol_export <- gene_tpm_symbol_export[, c("gene", setdiff(colnames(gene_tpm_symbol_export), "gene"))]

write_csv(gene_tpm_symbol_export, "gene_tpm_symbol_for_xCell2.csv")


