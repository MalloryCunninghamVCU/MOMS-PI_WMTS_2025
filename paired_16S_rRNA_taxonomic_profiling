        paired = TRUE,
        id = "ParticipantID",  # change to your ID column name if needed
        p.adjust.method = "BH"
      )
    if(nrow(pw) > 0){
      pw$Metric <- metric
      pw$Test <- "Pairwise Paired Wilcoxon (BH adj)"
      pw <- pw[, c("Metric", "Test", "group1", "group2", "p", "p.adj", "p.adj.signif")]
      names(pw) <- c("Metric", "Test", "Group1", "Group2", "P_value", "P_adj_BH", "Signif_BH")
      pairwise_table <- rbind(pairwise_table, pw)
    }
  }
}

