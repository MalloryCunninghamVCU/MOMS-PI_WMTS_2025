#only works w/ exatly two levels of factor variable
#################################################################

metrics <- c("Shannon", "Observed", "Evenness")
paired_results <- list()

# figure out the two unique levels of your Factor column -- no hardcoding required!
factor_levels <- sort(unique(alpha_div_merged$Factor))
if(length(factor_levels)!=2) stop("Factor variable must have exactly two levels for paired test.")

for (metric in metrics) {
  dat_metric <- alpha_div_merged[, c("ParticipantID", "Factor", metric)]
  # reshape wide so that each row has both timepoints for the same participant
  data_wide <- tidyr::pivot_wider(
    dat_metric,
    names_from = Factor,
    values_from = all_of(metric)
  )
  data_wide <- na.omit(data_wide)
  v1 <- data_wide[[ factor_levels[1] ]]
  v2 <- data_wide[[ factor_levels[2] ]]
  
  test <- wilcox.test(v1, v2, paired=TRUE, exact=FALSE)
  paired_results[[metric]] <- data.frame(
    Metric = metric,
    Test = paste("Paired Wilcoxon:", factor_levels[1], "vs", factor_levels[2]),
    P_value = test$p.value
  )
}
paired_results_df <- do.call(rbind, paired_results)
paired_results_df$P_adj_BH <- p.adjust(paired_results_df$P_value, method = "BH")
paired_results_df$Signif_BH <- cut(paired_results_df$P_adj_BH,
                                   breaks = c(-Inf, 0.001, 0.01, 0.05, Inf),
                                   labels = c("***","**","*","ns"))

print(paired_results_df)


